#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        bat_report: bat_report {
            compatible = "zmk,behavior-battery-report";
            #binding-cells = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &bat_report &kp A
                &kp B       &kp C
            >;
        };
    };
};
